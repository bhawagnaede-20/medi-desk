# MediDesk — Supabase environment variables
#
# Required by the Next.js frontend (browser + server + middleware).
# These must be set in your real deployment environment. Do not commit
# real credentials to source control.
#
# The service-role key (SUPABASE_SERVICE_ROLE_KEY) is intentionally NOT
# included here. It must never be shipped to the browser or used from
# frontend code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
