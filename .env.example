# MediDesk — Environment Variables (Placeholders)
#
# Copy this file to .env.local and fill in the actual values.
# NEVER commit real credentials or secrets to source control.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection URL
# Format: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL=

# ─── Session ────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Must be at least 32 characters.
# Generate a strong secret: openssl rand -hex 32
SESSION_SECRET=

# ─── Application ────────────────────────────────────────────────────────────
# Base URL of the application (used for generating links)
APP_URL=http://localhost:3000

# ─── Environment ────────────────────────────────────────────────────────────
# One of: development, production, test
NODE_ENV=development

# ─── Optional ──────────────────────────────────────────────────────────────
# OpenAI API key for AI features (optional)
OPENAI_API_KEY=

# Whether to trust the X-Forwarded-Proto header (set to true behind a proxy)
TRUST_PROXY=false

# IMPORTANT: Do NOT add NEXT_PUBLIC_* variables for secrets.
# Only expose non-sensitive configuration to the browser.
